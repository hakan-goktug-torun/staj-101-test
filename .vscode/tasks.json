{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Space Game",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "main.cpp",
                "playerinterface.cpp",
                "gameengine.cpp",
                "eventmanager.cpp",
                "spacepiratesevent.cpp",
                "abandonedplanetevent.cpp",
                "crossthebeltevent.cpp",
                "shipfactory.cpp",
                "scoreservice.cpp",
                "-o",
                "spacegame.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Derleme: spacegame.exe oluşturuluyor"
        }
    ]
}
